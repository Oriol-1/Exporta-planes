# --- APIs de IA (las únicas de pago) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Modelos (permiten cambiar sin tocar código) ---
SCREEN_MODEL=gpt-5-mini
WRITER_MODEL=claude-opus-5
WRITER_FALLBACK_MODEL=gpt-5

# --- Tope de gasto ---
AI_MONTHLY_BUDGET_EUR=5

# --- Identidad del rastreador (obligatoria: robots.txt y cortesía) ---
CRAWLER_USER_AGENT=bcn-curator/1.0 (+https://github.com/your_user_here/bcn-curator)
CRAWLER_CONTACT_EMAIL=your_contact_email_here

# --- Publicación ---
PUBLISH_BASE_URL=https://your_user_here.github.io/bcn-curator

# --- Endpoint alternativo compatible con OpenAI (opcional) ---
# Apunta el cribado a un MODELO LOCAL en vez de a la API de OpenAI. Es la única
# vía legítima de no pagar por token: la suscripción de ChatGPT no sirve para un
# programa desatendido, y GitHub Models está retirándose (devuelve 410).
#
#   Ollama:     ollama serve && ollama pull qwen2.5:7b
#               OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#               SCREEN_MODEL=qwen2.5:7b
#   LM Studio:  OPENAI_BASE_URL=http://127.0.0.1:1234/v1
#
# Con un modelo local NO hace falta OPENAI_API_KEY. Pierdes criterio editorial,
# así que mídelo con `pnpm eval:screen` antes de fiarte.
# OPENAI_BASE_URL=
